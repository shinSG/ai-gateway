flowchart TB
    subgraph STARTUP["Startup Layer"]
        BOOT["gateway-bootstrap\nSpring Boot Entry Point"]
    end

    subgraph CORE["Core Layer"]
        CORE_MOD["gateway-core\nFilters / Route Engine\nProtocol Handling / Security"]
    end

    subgraph BUSINESS["Business Layer"]
        REG["gateway-registry\nService Registration\nMetadata / Health Check"]
        ROUTER["gateway-router\nStatic Routing\nSemantic Routing / Load Balancing"]
        SEC["gateway-security\nOAuth2/JWT Auth\nRBAC / Audit Log"]
        ADMIN["gateway-admin\nAdmin Console Backend\nController / Service / Repository"]
    end

    subgraph COMMON["Common Layer"]
        COMMON_MOD["gateway-common\nData Model / Exceptions\nUtilities"]
    end

    subgraph FRONTEND["Frontend Layer"]
        CONSOLE["gateway-console\nVue 3 + Element Plus"]
    end

    BOOT -->|depends on| CORE_MOD

    CORE_MOD -->|depends on| REG
    CORE_MOD -->|depends on| ROUTER
    CORE_MOD -->|depends on| SEC
    CORE_MOD -->|depends on| COMMON_MOD

    REG -->|depends on| COMMON_MOD
    ROUTER -->|depends on| REG
    ROUTER -->|depends on| COMMON_MOD
    SEC -->|depends on| COMMON_MOD

    ADMIN -->|depends on| REG
    ADMIN -->|depends on| COMMON_MOD

    CONSOLE -.->|HTTP API| ADMIN

    subgraph INFRA_DEPS["Infrastructure Dependencies"]
        direction LR
        NACOS["Nacos\nService Discovery"]
        MILVUS["Milvus\nVector DB"]
        REDIS["Redis\nCache"]
        MYSQL["MySQL\nDatabase"]
        ROCKETMQ["RocketMQ\nMessage Queue"]
    end

    REG -->|registers with| NACOS
    ROUTER -->|vector search| MILVUS
    CORE_MOD -->|caching| REDIS
    ADMIN -->|data access| MYSQL
    REG -->|events| ROCKETMQ

    style STARTUP fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
